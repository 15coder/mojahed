{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "22.14.0",
      "pnpm": "10.26.1",
      "android": {
        "image": "ubuntu-22.04-jdk-17-ndk-r26b",
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_DOMAIN": "",
        "npm_config_frozen_lockfile": "false"
      }
    },
    "preview": {
      "distribution": "internal",
      "node": "22.14.0",
      "pnpm": "10.26.1",
      "android": {
        "image": "ubuntu-22.04-jdk-17-ndk-r26b",
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_DOMAIN": "",
        "npm_config_frozen_lockfile": "false"
      }
    },
    "production": {
      "autoIncrement": true,
      "node": "22.14.0",
      "pnpm": "10.26.1",
      "android": {
        "image": "ubuntu-22.04-jdk-17-ndk-r26b",
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_DOMAIN": "",
        "npm_config_frozen_lockfile": "false"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
